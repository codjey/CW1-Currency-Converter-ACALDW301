<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Heading with selected currency -->
        <TextView
            android:id="@+id/textConversionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GBP ⇄ ??? Converter"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Show the current rate -->
        <TextView
            android:id="@+id/textCurrentRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1 GBP = X.XX CODE"
            android:textSize="16sp" />

        <!-- Direction row: FROM → TO + flip button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textFromLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GBP"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="→"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textToLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USD"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFlip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Flip" />
        </LinearLayout>

        <!-- Single input field -->
        <EditText
            android:id="@+id/editAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Enter amount in GBP"
            android:inputType="numberDecimal"
            android:padding="8dp" />

        <!-- Single convert button -->
        <Button
            android:id="@+id/btnConvert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Convert" />

        <!-- Result output -->
        <TextView
            android:id="@+id/textResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Result will appear here."
            android:textSize="16sp" />

        <!-- Error / hint text -->
        <TextView
            android:id="@+id/textError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="@android:color/holo_red_dark"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
